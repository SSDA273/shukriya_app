<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ Splash Screen with Increased Canvas Diameter
    
    Uses the auto-generated drawable from flutter_native_splash
    - Layer 1: Outer oval circle (expanded canvas background)
    - Layer 2: Logo image (the auto-generated android12splash drawable)
    
    Result: Logo stays same visibility, larger canvas diameter
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Layer 1: Outer Circle Background (Expanded Canvas) -->
    <!-- Edit the android:width and android:height below to change canvas diameter -->
    <item
        android:width="500dp"
        android:height="500dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#E0F2F1" />
        </shape>
    </item>
    
    <!-- Layer 2: Logo Image (Auto-generated by flutter_native_splash) -->
    <item
        android:drawable="@drawable/android12splash"
        android:gravity="center"
        android:width="150dp"
        android:height="150dp" />
        
</layer-list>
